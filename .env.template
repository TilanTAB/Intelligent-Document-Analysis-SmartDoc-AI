# SmartDoc AI Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# LLM provider selection: google | openai | azure
LLM_PROVIDER=openai

# OpenAI API Key (required when LLM_PROVIDER=openai)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI (use these when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your_azure_api_key_here
# Optional: separate key for Azure embeddings
# AZURE_EMBEDDING_API_KEY=your_azure_embedding_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=your_chat_deployment_name
# Optional: separate endpoint for Azure embeddings
# AZURE_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
AZURE_EMBEDDING_DEPLOYMENT=your_embedding_deployment_name

# Google API Key for Gemini models (only needed if you switch LLM_PROVIDER=google or enable Google vision/embeddings)
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# OPTIONAL SETTINGS (with defaults)
# =============================================================================

# Database settings
# CHROMA_DB_PATH=./chroma_db

# Chunking settings
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# CHUNK_SIZE_TEXT=2000
# CHUNK_OVERLAP_TEXT=100
# CHUNK_SIZE_TABLE=1400
# CHUNK_OVERLAP_TABLE=80
# CHUNK_SIZE_CHART=2600
# CHUNK_OVERLAP_CHART=120
# PRE_INGEST_DEDUPE_ENABLED=true
# PRE_INGEST_COMPRESS_WHITESPACE=true
# PRE_INGEST_MIN_CHUNK_CHARS=40
# MAX_INDEX_CHUNKS=2000         # 0 disables pre-ingest chunk capping
# PDF_PARSE_MODE=fidelity             # auto|fast values are accepted for backward compatibility but treated as fidelity
# PDF_PARSE_PAGE_RANGE_WORKERS=1      # >1 enables page-range parse parallelism for large PDFs
# PDF_PARSE_PAGE_RANGE_SIZE=24        # pages per parallel task when workers>1

# Retriever settings
# VECTOR_SEARCH_K=5          # Number of documents to retrieve via vector search
# VECTOR_FETCH_K=20          # Candidate pool size for MMR
# VECTOR_SCORE_THRESHOLD=0.3 # Minimum relevance score (0-1)
# BM25_SEARCH_K=5            # Number of documents to retrieve via BM25
# HYBRID_RETRIEVER_WEIGHTS=[0.4, 0.6]  # [BM25 weight, Vector weight]
# CHROMA_INGEST_BATCH_SIZE=100
# VECTOR_INGEST_PARALLEL_WORKERS=1     # >1 enables parallel ingest workers
# CHROMA_HNSW_M=32
# CHROMA_HNSW_CONSTRUCTION_EF=100
# CHROMA_HNSW_SEARCH_EF=80
# CHROMA_HNSW_NUM_THREADS=8
# CHROMA_HNSW_BATCH_SIZE=100
# CHROMA_HNSW_SYNC_THRESHOLD=1000

# Logging settings
# LOG_LEVEL=INFO
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=smartdoc-ai
# OTEL_SERVICE_NAMESPACE=smartrag
# OTEL_SERVICE_VERSION=dev
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,team=rag
# OTEL_TRACES_ENABLED=true
# OTEL_METRICS_ENABLED=true
# OTEL_LOGS_ENABLED=true
# OTEL_METRICS_EXPORT_INTERVAL_MS=10000
# OTEL_EXPORT_TIMEOUT_S=10
# OTEL_CONSOLE_DEBUG_EXPORT=false
#
# OTLP endpoint options:
# 1) Set one base endpoint (signal paths are appended automatically).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
#
# 2) Or set per-signal endpoints explicitly.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs
#
# Optional OTLP headers (comma-separated key=value pairs).
# Grafana Cloud example:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance_id:api_token)>

# Cache settings
# CACHE_DIR=document_cache
# CACHE_EXPIRE_DAYS=7

# LLM settings
# LLM_MAX_RETRIES=3
# LLM_RETRY_DELAY=1.0
# LLM_MODEL_NAME=gpt-4o-mini  # Default model for all agents (low-cost GPT)

# Agent-specific LLM models (override LLM_MODEL_NAME if needed)
# RESEARCH_AGENT_MODEL=gpt-4o-mini
# VERIFICATION_AGENT_MODEL=gpt-4o-mini
# RELEVANCE_CHECKER_MODEL=gpt-4o-mini
# RESEARCH_MAX_OUTPUT_TOKENS=4000
# RESEARCH_MIN_ANSWER_CHARS=300
# RELEVANCE_MAX_OUTPUT_TOKENS=4000
# RELEVANCE_RETRY_MAX_OUTPUT_TOKENS=8000
# VERIFICATION_MAX_OUTPUT_TOKENS=128000
# VERIFICATION_RETRY_MAX_OUTPUT_TOKENS=128000
# LLM_ROUTER_MAX_OUTPUT_TOKENS=4000

# Embeddings
# EMBEDDING_PROVIDER=openai   # google | openai | azure
# EMBEDDING_MODEL_NAME=models/text-embedding-004
# OPENAI_EMBEDDING_MODEL_NAME=text-embedding-3-small
# AZURE_EMBEDDING_API_KEY=your_azure_embedding_api_key_here
# AZURE_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
# AZURE_EMBEDDING_DEPLOYMENT=your_embedding_deployment_name
# EMBEDDING_CACHE_ENABLED=true
# EMBEDDING_CACHE_DIR=document_cache/embedding_cache
# EMBEDDING_CACHE_BATCH_SIZE=128
# EMBEDDING_INGEST_MAX_RETRIES=4
# EMBEDDING_BACKOFF_BASE_S=1.0
# EMBEDDING_BACKOFF_MAX_S=12.0
# EMBEDDING_BACKOFF_JITTER_RATIO=0.25

# Performance metrics / alerts
# PERF_METRICS_WINDOW=200
# PERF_ALERT_MIN_SAMPLES=5
# PERF_ALERT_COOLDOWN_S=300
# PERF_ALERT_PARSE_P95_S=90
# PERF_ALERT_CHART_PHASE1_P95_S=120
# PERF_ALERT_CHART_PHASE2_P95_S=45
# PERF_ALERT_EMBED_BATCH_P95_S=10

# Vision / chart analysis
# VISION_PROVIDER=none        # google | azure | none
# CHART_VISION_MODEL=gpt-5-nano   # use gemini-2.5-flash-lite for Google vision

# Server settings (optional, for Gradio)
# GRADIO_SERVER_PORT=7860
